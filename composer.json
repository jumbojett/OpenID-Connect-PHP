{
    "name": "jumbojett/openid-connect-php",
    "description": "Bare-bones OpenID Connect client",
    "license": "Apache-2.0",
    "require": {
        "php": ">=7.2",
        "ext-json": "*",
        "ext-curl": "*",
        "phpseclib/phpseclib": "^4.0.3"
    },
    "require-dev": {
        "phpunit/phpunit": "<10",
        "yoast/phpunit-polyfills": "^4.0"
    },
    "archive" : {
        "exclude" : [
            ".*"
        ]
    },
    "autoload" : {
         "classmap": [ "src/"]
    }
}
